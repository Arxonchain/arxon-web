# ============================================================
# ARXON - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in your OWN Supabase values.
# Get these from: https://supabase.com/dashboard -> your project -> Settings -> API
# NEVER commit .env to git!
# ============================================================

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-public-key-here

# Optional: used only for local Supabase CLI commands (not exposed to browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Supabase Edge Function secrets (set in Supabase Dashboard)
# Project Settings -> Edge Functions -> Secrets
# ============================================================
# ADMIN_APPROVER_EMAIL=gabemetax@gmail.com
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM_EMAIL=Arxon Admin <notifications@yourdomain.com>
# SITE_URL=https://arxon.io
